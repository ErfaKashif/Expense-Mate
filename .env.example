# ExpenseMate configuration. Copy to `.env` and fill in real values.
# `.env` is listed in .gitignore -- NEVER commit real passwords.

# PostgreSQL database used by the application
DATABASE_URL=postgresql://expensemate:change-me@localhost:5432/expensemate

# Separate PostgreSQL database used ONLY by the automated tests.
# The test-suite deletes all rows in this database between tests.
TEST_DATABASE_URL=postgresql://expensemate:change-me@localhost:5432/expensemate_test

# Secret used to sign login (JWT) tokens -- use a long random value, e.g.
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=replace-with-a-long-random-secret

# Optional
# PORT=5000
# LOG_LEVEL=INFO
